{
  "providers": {
    "local-gateway": {
      "type": "openai",
      "baseUrl": "http://127.0.0.1:8000/v1"
    }
  },
  "models": {
    "local/model": {
      "provider": "local-gateway",
      "model": "your-model-name"
    }
  },
  "policy": {},
  "http": {
    "host": "127.0.0.1",
    "port": 8787,
    "path": "/mcp",
    "tenants": {
      "writer": {
        "apiKeyEnv": "MODEL_TOOL_WRITER_KEY",
        "models": ["local/model"],
        "scopes": ["models:read", "models:ask"]
      }
    }
  }
}
