{
  "providers": {
    "magpie-local": {
      "type": "openai",
      "baseUrl": "http://127.0.0.1:8000/v1"
    }
  },
  "models": {
    "magpie/local": {
      "provider": "magpie-local",
      "model": "magpie-model"
    }
  },
  "policy": {},
  "http": {
    "host": "127.0.0.1",
    "port": 8787,
    "path": "/mcp",
    "tenants": {
      "writer": {
        "apiKeyEnv": "MODEL_TOOL_WRITER_KEY",
        "models": ["magpie/local"],
        "scopes": ["models:read", "models:ask"]
      }
    }
  }
}
